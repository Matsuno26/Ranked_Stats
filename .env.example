# Clés API du serveur Ranked Stats (à remplir une seule fois par celui qui héberge le site).
# Copie ce fichier en ".env" et colle les clés. Les joueurs n'ont rien à saisir.

# Valorant — HenrikDev : Discord HenrikDev (lien sur https://docs.henrikdev.xyz), salon #get-a-key
HENRIK_API_KEY=

# Rocket League — ballchasing.com : connexion Steam, puis https://ballchasing.com/upload → API key
BALLCHASING_API_KEY=

# Rainbow Six Siege — R6 Data / Arenyze : compte sur https://r6.arenyze.com, tableau de bord → API key
R6DATA_API_KEY=

# Overwatch n'a pas besoin de clé (OverFast API).
